rules_version = '2';

// Notes app - Cloud Firestore security rules.
// Every note lives at  users/{uid}/notes/{noteId}. Only the signed-in owner (uid == {uid}), signed in
// with Google and with a verified e-mail, can touch it. Everything else in the database is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    // The caller is the owner of this user path and came in through Google sign-in.
    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.token.email_verified == true;
    }

    // A timestamp in epoch milliseconds that is not further than one day ahead of the server clock.
    function sane(ms) {
      return ms is int && ms > 0 && ms <= request.time.toMillis() + 86400000;
    }

    // Shape of a note document: exactly these fields, with these types and sizes.
    function validNote(d) {
      return d.keys().hasOnly(['title', 'body', 'kind', 'color', 'pinned', 'archived', 'trashed',
                               'purged', 'createdAt', 'updatedAt', 'syncedAt'])
          && d.keys().hasAll(['title', 'body', 'kind', 'color', 'pinned', 'archived', 'trashed',
                              'purged', 'createdAt', 'updatedAt', 'syncedAt'])
          && d.title is string && d.title.size() <= 500
          && d.body is string && d.body.size() <= 200000
          && d.kind is int && d.kind >= 0 && d.kind <= 1
          && d.color is int && d.color >= 0 && d.color <= 20
          && d.pinned is bool && d.archived is bool && d.trashed is bool && d.purged is bool
          && sane(d.createdAt)
          && sane(d.updatedAt) && d.updatedAt >= d.createdAt
          // a permanently deleted note is an empty tombstone: no content can hide in it
          && (d.purged == false || (d.title == '' && d.body == '' && d.pinned == false))
          && d.syncedAt == request.time;   // server time, set by the app with a REQUEST_TIME transform
    }

    match /users/{uid}/notes/{noteId} {
      allow get: if isOwner(uid);

      // listing is allowed only with an explicit page size, so one request can never pull an unbounded result
      allow list: if isOwner(uid)
                  && request.query.limit <= 500;

      allow create: if isOwner(uid)
                    && noteId.matches('[A-Za-z0-9_-]{1,64}')
                    && validNote(request.resource.data);

      // creation time can never be rewritten, a change must move updatedAt forward,
      // and a tombstone can not be turned back into a live note
      allow update: if isOwner(uid)
                    && validNote(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt >= resource.data.updatedAt
                    && (resource.data.purged == false || request.resource.data.purged == true);

      // only used by "Delete all my data"; normal deletes are written as empty "purged" tombstones
      allow delete: if isOwner(uid);
    }

    // Anything else: closed (no other collections, no listing of other users).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
