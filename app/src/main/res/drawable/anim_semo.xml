<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_semo_splash">

    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:duration="900" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleX" android:valueFrom="0.88" android:valueTo="1" android:valueType="floatType" />
                <objectAnimator android:duration="900" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:valueFrom="0.88" android:valueTo="1" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="s">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="620" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="0" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="h1">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="420" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="h2">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="500" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="700" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="150" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="tail">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="trimPathEnd" android:startOffset="520" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
