<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/act_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/act_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/act_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/act_close_exit</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">?attr/n_accent_text</item>
        <item name="colorControlNormal">?attr/n_text_secondary</item>
        <item name="colorControlActivated">?attr/n_accent_text</item>
        <item name="android:textColorHint">?attr/n_text_hint</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">?attr/n_text_primary</item>
        <item name="android:textColorSecondary">?attr/n_text_secondary</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/DialogAnim</item>
        <item name="windowMinWidthMinor">92%</item>
        <item name="windowMinWidthMajor">60%</item>
        <item name="android:windowElevation">0dp</item>
    </style>

    <style name="DialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dlg_in</item>
        <item name="android:windowExitAnimation">@anim/dlg_out</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">?attr/n_text_primary</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="BtnPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">?attr/n_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="BtnSecondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">?attr/n_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/anim_mark</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
