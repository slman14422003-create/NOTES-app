<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/n_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header_large" />

    <View
        android:id="@+id/headerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="?attr/n_stroke_soft" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="132dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_input"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="?attr/n_text_hint"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textAlignment="viewStart"
                android:textColor="?attr/n_text_primary"
                android:textColorHint="?attr/n_text_hint"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/quick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="9dp"
                android:orientation="horizontal" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="2dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/secPinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="26dp"
                android:paddingTop="16dp"
                android:paddingEnd="26dp"
                android:paddingBottom="6dp"
                android:text="@string/sec_pinned"
                android:textAlignment="viewStart"
                android:textColor="?attr/n_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridPinned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/secAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="26dp"
                android:paddingTop="16dp"
                android:paddingEnd="26dp"
                android:paddingBottom="6dp"
                android:textAlignment="viewStart"
                android:textColor="?attr/n_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gridAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:orientation="horizontal" />

            <Button
                android:id="@+id/btnMore"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:text="@string/show_more"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEmptyTrash"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="14dp"
                android:text="@string/empty_trash"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/emptyBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="48dp"
                android:paddingEnd="40dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/emptyIcon"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_circle_accent"
                    android:importantForAccessibility="no"
                    android:padding="22dp"
                    android:src="@drawable/ic_note"
                    android:tint="?attr/n_accent_text" />

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="?attr/n_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?attr/n_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

    <!-- undo bar: shown for a few seconds after moving a note to the trash / archive -->
    <LinearLayout
        android:id="@+id/undoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_composer"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/undoMsg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textColor="?attr/n_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/undoBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/undo"
            android:textColor="?attr/n_accent_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- quick capture: a floating pill; type, press send, the note is saved (and synced) -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_composer"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnList"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_flat"
            android:contentDescription="@string/new_checklist"
            android:scaleType="center"
            android:src="@drawable/ic_checklist"
            android:tint="?attr/n_text_secondary" />

        <EditText
            android:id="@+id/quickText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/quick_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="?attr/n_text_primary"
            android:textColorHint="?attr/n_text_hint"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_solid"
            android:contentDescription="@string/save"
            android:scaleType="center"
            android:src="@drawable/ic_send"
            android:tint="?attr/n_on_accent" />
    </LinearLayout>
    </LinearLayout>
    </FrameLayout>

</LinearLayout>
