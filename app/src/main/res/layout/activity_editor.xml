<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/n_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="320dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/noteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="serif"
                android:hint="@string/title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textAlignment="textStart"
                android:textDirection="firstStrong"
                android:textColor="?attr/n_text_primary"
                android:textColorHint="?attr/n_text_hint"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:textAlignment="viewStart"
                android:textColor="?attr/n_text_secondary"
                android:textSize="12sp" />

            <!-- phone numbers and links found in the note: tap to call / open, long-press to copy -->
            <HorizontalScrollView
                android:id="@+id/smartScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/smartRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/body_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:minHeight="240dp"
                android:textAlignment="textStart"
                android:textDirection="firstStrong"
                android:textColor="?attr/n_text_primary"
                android:textColorHint="?attr/n_text_hint"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/addItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="?attr/n_accent_text"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/add_item"
                android:textColor="?attr/n_accent_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@drawable/bg_pill_neutral"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_checklist"
            android:drawableTint="?attr/n_text_primary"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:textColor="?attr/n_text_primary"
            android:textSize="14sp" />

        <!-- colour picker: seven dots spread evenly inside one rounded capsule -->
        <LinearLayout
            android:id="@+id/palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_neutral"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>
</LinearLayout>
