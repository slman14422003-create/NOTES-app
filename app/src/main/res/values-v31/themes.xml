<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+: same splash as values/themes.xml plus the small SEMO STUDIO logo at the bottom.
         windowSplashScreenBrandingImage is a framework attribute (API 31), NOT part of core-splashscreen,
         so it must be written with the android: prefix and only in a v31+ resource folder.
         (390x156 px at xxhdpi = 130x52 dp, kept small on purpose) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/anim_mark</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_brand</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
